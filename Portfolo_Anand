  <style>
    :root {
      --bg: #f7f7f5;
      --surface: #ffffff;
      --text: #111111;
      --muted: #6b6b6b;
      --border: #e5e5e2;
      --accent: #3157d5;
      --accent-dark: #2444ae;
      --soft: #eef2ff;
      --max-width: 1180px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(var(--max-width), calc(100% - 48px));
      margin: 0 auto;
    }

    /* NAVIGATION */

    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(247, 247, 245, 0.88);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(229, 229, 226, 0.8);
    }

    .nav-inner {
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: "Manrope", sans-serif;
      font-weight: 800;
      font-size: 19px;
      letter-spacing: -0.04em;
    }

    .nav-links {
      display: flex;
      gap: 32px;
      align-items: center;
      font-size: 14px;
      color: #444;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .nav-cta {
      background: var(--text);
      color: white !important;
      padding: 10px 17px;
      border-radius: 999px;
    }

    /* HERO */

    .hero {
      padding: 190px 0 120px;
      min-height: 92vh;
      display: flex;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-size: 13px;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 25px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
    }

    h1 {
      font-family: "Manrope", sans-serif;
      font-size: clamp(54px, 7vw, 94px);
      line-height: 0.98;
      letter-spacing: -0.07em;
      max-width: 980px;
      font-weight: 700;
    }

    .hero h1 span {
      color: var(--muted);
    }

    .hero-description {
      max-width: 650px;
      font-size: 20px;
      line-height: 1.6;
      color: var(--muted);
      margin-top: 32px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      margin-top: 38px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 21px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      transition: 0.2s ease;
    }

    .button-primary {
      background: var(--text);
      color: white;
    }

    .button-primary:hover {
      background: #333;
      transform: translateY(-2px);
    }

    .button-secondary {
      border: 1px solid var(--border);
      background: white;
    }

    .button-secondary:hover {
      border-color: #aaa;
      transform: translateY(-2px);
    }

    /* SECTIONS */

    section {
      padding: 120px 0;
      border-top: 1px solid var(--border);
    }

    .section-header {
      display: grid;
      grid-template-columns: 0.8fr 1.5fr;
      gap: 60px;
      margin-bottom: 65px;
    }

    .section-number {
      font-size: 13px;
      color: var(--accent);
      font-weight: 600;
      letter-spacing: 0.08em;
    }

    h2 {
      font-family: "Manrope", sans-serif;
      font-size: clamp(38px, 5vw, 62px);
      line-height: 1.05;
      letter-spacing: -0.055em;
    }

    .section-intro {
      max-width: 680px;
      color: var(--muted);
      font-size: 18px;
      margin-top: 20px;
    }

    /* ABOUT */

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }

    .about-large {
      font-family: "Manrope", sans-serif;
      font-size: 31px;
      line-height: 1.25;
      letter-spacing: -0.035em;
    }

    .about-copy {
      color: var(--muted);
      font-size: 16px;
    }

    .about-copy p + p {
      margin-top: 20px;
    }

    /* SYSTEM DIAGRAM */

    .system {
      margin-top: 75px;
      padding: 35px;
      border: 1px solid var(--border);
      background: white;
      border-radius: 22px;
    }

    .system-title {
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin-bottom: 28px;
    }

    .system-flow {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
    }

    .system-item {
      padding: 22px 15px;
      border: 1px solid var(--border);
      border-radius: 13px;
      text-align: center;
      font-size: 13px;
      font-weight: 600;
      background: var(--bg);
    }

    .system-item:not(:last-child)::after {
      content: "→";
      position: absolute;
    }

    /* RESEARCHOS */

    .researchos {
      background: #111;
      color: white;
      border-radius: 28px;
      padding: 70px;
      overflow: hidden;
      position: relative;
    }

    .researchos::after {
      content: "";
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.1);
      right: -200px;
      top: -200px;
    }

    .researchos-label {
      color: #9eafff;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 600;
    }

    .researchos h3 {
      font-family: "Manrope", sans-serif;
      font-size: clamp(38px, 5vw, 64px);
      line-height: 1.02;
      letter-spacing: -0.055em;
      max-width: 800px;
      margin-top: 22px;
    }

    .researchos p {
      color: #aaa;
      max-width: 650px;
      font-size: 17px;
      margin-top: 25px;
    }

    .research-loop {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 45px;
    }

    .loop-item {
      border: 1px solid #333;
      padding: 11px 16px;
      border-radius: 999px;
      font-size: 13px;
      color: #ddd;
    }

    /* WORK */

    .work-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .work-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 34px;
      min-height: 340px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: 0.25s ease;
    }

    .work-card:hover {
      transform: translateY(-5px);
      border-color: #cfcfca;
      box-shadow: 0 15px 45px rgba(0,0,0,0.05);
    }

    .work-category {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      font-weight: 600;
    }

    .work-card h3 {
      font-family: "Manrope", sans-serif;
      font-size: 30px;
      letter-spacing: -0.04em;
      margin-top: 12px;
    }

    .work-card p {
      color: var(--muted);
      margin-top: 12px;
    }

    .work-link {
      margin-top: 30px;
      font-size: 14px;
      font-weight: 600;
    }

    /* EXPERIENCE */

    .timeline {
      max-width: 900px;
      margin-left: auto;
    }

    .experience {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 50px;
      padding: 42px 0;
      border-top: 1px solid var(--border);
    }

    .experience:last-child {
      border-bottom: 1px solid var(--border);
    }

    .experience-date {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }

    .experience-company {
      font-size: 13px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
    }

    .experience h3 {
      font-family: "Manrope", sans-serif;
      font-size: 30px;
      letter-spacing: -0.04em;
      margin-top: 7px;
    }

    .experience-description {
      color: var(--muted);
      margin-top: 12px;
    }

    /* CAPABILITIES */

    .capabilities {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      border-top: 1px solid var(--border);
    }

    .capability {
      padding: 30px 0;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: baseline;
      gap: 25px;
    }

    .capability:nth-child(odd) {
      margin-right: 35px;
    }

    .capability-number {
      color: var(--accent);
      font-size: 12px;
      font-weight: 600;
    }

    .capability h3 {
      font-family: "Manrope", sans-serif;
      font-size: 21px;
      letter-spacing: -0.025em;
    }

    /* INSIGHTS */

    .insights {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .insight {
      background: white;
      border: 1px solid var(--border);
      padding: 30px;
      border-radius: 18px;
      min-height: 230px;
    }

    .insight-category {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
    }

    .insight h3 {
      font-family: "Manrope", sans-serif;
      font-size: 23px;
      line-height: 1.2;
      margin-top: 25px;
    }

    /* CONTACT */

    .contact {
      padding: 150px 0;
      text-align: center;
    }

    .contact h2 {
      max-width: 850px;
      margin: 0 auto;
    }

    .contact p {
      color: var(--muted);
      max-width: 520px;
      margin: 25px auto 0;
      font-size: 17px;
    }

    .contact-actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 35px;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid var(--border);
      padding: 30px 0;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 13px;
    }

    /* MOBILE */

    @media (max-width: 800px) {

      .container {
        width: min(100% - 32px, var(--max-width));
      }

      .nav-links {
        display: none;
      }

      .hero {
        padding: 150px 0 90px;
      }

      h1 {
        font-size: 55px;
      }

      .hero-description {
        font-size: 17px;
      }

      section {
        padding: 85px 0;
      }

      .section-header,
      .about-grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }

      .system-flow {
        grid-template-columns: repeat(2, 1fr);
      }

      .researchos {
        padding: 40px 25px;
      }

      .work-grid,
      .capabilities,
      .insights {
        grid-template-columns: 1fr;
      }

      .capability:nth-child(odd) {
        margin-right: 0;
      }

      .experience {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .footer-inner {
        flex-direction: column;
        gap: 10px;
      }

      .hero-actions,
      .contact-actions {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

